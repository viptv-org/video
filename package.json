{
  "name": "@viptv/video",
  "version": "0.4.0",
  "author": "VIPTV contributors",
  "description": "VIPTV headless playback controller: one Player interface, platform adapters, and the server session coordinator",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viptv-org/video.git"
  },
  "homepage": "https://github.com/viptv-org/video#readme",
  "bugs": {
    "url": "https://github.com/viptv-org/video/issues"
  },
  "sideEffects": false,
  "keywords": [
    "video",
    "playback",
    "smart-tv",
    "webcodecs",
    "hls",
    "tauri"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.js",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/index.d.ts",
      "import": "./dist-js/index.js"
    }
  },
  "files": [
    "dist-js",
    "docs/*.md",
    "CHANGELOG.md",
    "VERSIONING.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediabunny/ac3": "^1.56.2",
    "@mediabunny/dts": "^1.56.2",
    "@mediabunny/prores": "^1.56.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "hls.js": "1.7.3",
    "mediabunny": "1.56.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^24.13.3",
    "jsdom": "^26.0.0",
    "rollup": "^4.9.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "vite": "6.1.0"
  }
}
